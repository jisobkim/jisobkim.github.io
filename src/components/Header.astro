---
import { type Lang, SITE_TITLE, UI, prefix } from '../consts';
import HeaderLink from './HeaderLink.astro';

interface Props {
	lang?: Lang;
	alt?: string;
}

const { lang = 'ko', alt } = Astro.props;
const other: Lang = lang === 'ko' ? 'en' : 'ko';
const switchHref = alt ?? UI[other].home;
---

<header>
	<nav>
		<h2>
			<a href={UI[lang].home}>{SITE_TITLE}</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href={UI[lang].home}>Home</HeaderLink>
			<HeaderLink href={`${prefix(lang)}/about`}>About</HeaderLink>
			<a href={switchHref} hreflang={other} onclick={`localStorage.setItem('lang','${other}')`}>{UI[lang].switchLabel}</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: #fff;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	nav {
		width: 720px;
		max-width: 100%;
		margin: auto;
	}
	h2 {
		margin: 0;
		font-size: 1em;
		letter-spacing: 0.02em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--gray));
		text-decoration: none;
	}
	nav a:hover,
	nav a.active {
		color: var(--accent);
		text-decoration: none;
	}
	nav h2 a {
		padding-left: 0;
		color: rgb(var(--black));
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>

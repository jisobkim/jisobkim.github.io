---
// giscus.app 에서 Discussions 설정 후 받은 ID를 채운다. 비어 있으면 렌더하지 않는다.
const REPO = 'jisobkim/jisobkim.github.io';
const REPO_ID = 'R_kgDOVWZK-Q';
const CATEGORY = 'Announcements';
const CATEGORY_ID = 'DIC_kwDOVWZK-c4DLOi0';
const { lang = 'ko' } = Astro.props as { lang?: 'ko' | 'en' };
---

{REPO_ID && CATEGORY_ID && (
	<script
		is:inline
		src="https://giscus.app/client.js"
		data-repo={REPO}
		data-repo-id={REPO_ID}
		data-category={CATEGORY}
		data-category-id={CATEGORY_ID}
		data-mapping="pathname"
		data-strict="0"
		data-reactions-enabled="1"
		data-input-position="bottom"
		data-theme="light"
		data-lang={lang}
		crossorigin="anonymous"
		async
	></script>
)}

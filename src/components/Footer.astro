---
import { type Lang, UI, prefix } from '../consts';

const { lang = 'ko' } = Astro.props as { lang?: Lang };
const t = UI[lang];
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} JISUB KIM
	<nav class="footer-links">
		<a href={`${prefix(lang)}/about`}>{t.about}</a> · <a href={`${prefix(lang)}/privacy`}>{t.privacy}</a> · <a href="mailto:qn51z07734@gmail.com">{t.contact}</a>
	</nav>
</footer>
<style>
	footer {
		padding: 2em 1em 4em 1em;
		border-top: 1px solid rgb(var(--gray-light));
		color: rgb(var(--gray));
		font-size: 0.85em;
		text-align: center;
	}
	footer a {
		color: inherit;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 1em;
	}
	.social-links a {
		text-decoration: none;
		color: rgb(var(--gray));
	}
	.social-links a:hover {
		color: rgb(var(--gray-dark));
	}
</style>

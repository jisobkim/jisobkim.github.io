---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Comments from '../../components/Comments.astro';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const en = new Set((await getCollection('blogEn')).map((p) => p.id));
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post, alt: en.has(post.id) ? `/en/blog/${post.id}/` : undefined },
	}));
}
type Props = { post: CollectionEntry<'blog'>; alt?: string };

const { post, alt } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} alt={alt}>
	<Content />
	<Comments />
</BlogPost>

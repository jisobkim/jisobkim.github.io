---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { type Lang, SITE_TITLE, UI, prefix } from '../consts';

const { lang = 'ko' } = Astro.props as { lang?: Lang };
const other: Lang = lang === 'ko' ? 'en' : 'ko';
const posts = (await getCollection(lang === 'en' ? 'blogEn' : 'blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={SITE_TITLE} description={UI[lang].description} lang={lang} alt={UI[other].home} />
		<style>
			ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			li + li {
				border-top: 1px solid rgb(var(--gray-light));
			}
			li a {
				display: flex;
				gap: 1.5rem;
				align-items: center;
				padding: 1.5rem 0;
				color: inherit;
				text-decoration: none;
			}
			.text {
				flex: 1;
				min-width: 0;
			}
			.title {
				margin: 0 0 0.4rem;
				font-size: 1.2em;
			}
			li a:hover .title {
				color: var(--accent);
			}
			.desc {
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
				margin: 0 0 0.5rem;
				color: rgb(var(--gray-dark));
			}
			.meta {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.85em;
			}
			.thumb {
				flex: none;
				width: 30%;
				max-width: 200px;
				height: auto;
				aspect-ratio: 16 / 9;
				object-fit: cover;
				border-radius: 6px;
				border: 1px solid rgb(var(--gray-light));
			}
			@media (max-width: 720px) {
				li a {
					flex-direction: column-reverse;
					align-items: stretch;
					gap: 0.9rem;
				}
				.thumb {
					width: 100%;
					max-width: none;
				}
			}
		</style>
	</head>
	<body>
		<Header lang={lang} alt={UI[other].home} />
		<main>
			<section>
				<ul>
					{posts.map((post) => (
						<li>
							<a href={`${prefix(lang)}/blog/${post.id}/`}>
								<div class="text">
									<h2 class="title">{post.data.title}</h2>
									<p class="desc">{post.data.description}</p>
									<p class="meta">
										<FormattedDate date={post.data.pubDate} />
										{post.data.tags.length > 0 && ` · ${post.data.tags.slice(0, 3).join(', ')}`}
									</p>
								</div>
								{post.data.heroImage && (
									<Image class="thumb" width={720} height={405} src={post.data.heroImage} alt="" />
								)}
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer lang={lang} />
	</body>
</html>

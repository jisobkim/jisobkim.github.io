---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import type { Lang } from '../consts';

type Props = Omit<CollectionEntry<'blog'>['data'], 'tags'> & { lang?: Lang; alt?: string };

const { title, description, pubDate, updatedDate, heroImage, lang = 'ko', alt } = Astro.props;
---

<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} image={heroImage} lang={lang} alt={alt} />
		<style>
			.hero-image img {
				display: block;
				width: 100%;
				border-radius: 6px;
				border: 1px solid rgb(var(--gray-light));
			}
			.prose {
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1.5em 0 0;
				line-height: 1.35;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header lang={lang} alt={alt} />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1440} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{updatedDate && (
								<div class="last-updated-on">
									Last updated on <FormattedDate date={updatedDate} />
								</div>
							)}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer lang={lang} />
		<script is:inline type="module">
			const blocks = document.querySelectorAll('pre[data-language="mermaid"]');
			if (blocks.length) {
				const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
				for (const pre of blocks) {
					const div = document.createElement('div');
					div.className = 'mermaid';
					div.textContent = pre.textContent;
					pre.replaceWith(div);
				}
				mermaid.initialize({ startOnLoad: false, theme: 'neutral' });
				await mermaid.run();
			}
		</script>
	</body>
</html>
